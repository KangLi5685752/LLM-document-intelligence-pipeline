{
  "behavior_contracts": {
    "action_status_phrase_coverage": {
      "allowed_subject_types": [
        "initiative",
        "policy",
        "programme"
      ],
      "explicit_status_values": [
        "completed",
        "delayed",
        "delivered",
        "in progress",
        "met",
        "not started",
        "on track"
      ],
      "required_action_cues": [
        "action",
        "activity",
        "deliverable",
        "delivery",
        "implementation",
        "milestone",
        "phase",
        "progress",
        "recommendation",
        "rollout",
        "step",
        "task",
        "work",
        "workstream"
      ],
      "same_statement_only": true,
      "subject_must_pass_shared_bounds": true,
      "warning_code": "abstained_action_status_ineligible_subject"
    },
    "ambiguous_metric": {
      "bounds_exceeded_behavior": "abstain_without_candidates",
      "bounds_exceeded_warning_code": "abstained_ambiguous_metric_bounds_exceeded",
      "candidate_warning_code": "ambiguous_metric_value_relationship",
      "confidence": 0.5,
      "deterministic_output_order": [
        "evidence_block_sequence",
        "evidence_start_offset",
        "normalized_subject_text",
        "typed_normalized_value",
        "candidate_id"
      ],
      "evidence_status": "ambiguous",
      "maximum_interpretation_count": 3,
      "maximum_value_count": 3,
      "output_behavior": "emit_every_bounded_plausible_interpretation_without_selecting_one",
      "review_status": "required",
      "same_statement_only": true
    },
    "candidate_contract_guard": {
      "incompatible_candidate_behavior": "omit_candidate_and_continue_document",
      "no_type_coercion": true,
      "preserve_other_candidates": true,
      "unexpected_errors": "fail_document",
      "validation_scope": [
        "predicate",
        "subject_type",
        "value_type",
        "required_qualifiers",
        "declared_qualifier_names"
      ],
      "warning_code": "abstained_incompatible_predicate_contract"
    },
    "commitment": {
      "allowed_subject_types": [
        "initiative",
        "organisation",
        "other",
        "policy",
        "programme"
      ],
      "clause_like_rejection": {
        "boundary_characters": [
          ":",
          ";",
          "?",
          "!",
          "newline"
        ],
        "reject_coordinated_finite_clauses": true,
        "relative_or_subordinate_markers": [
          "although",
          "because",
          "if",
          "that",
          "when",
          "where",
          "which",
          "while",
          "who"
        ]
      },
      "confidence": {
        "explicit": 0.9,
        "weak": 0.7
      },
      "copular_and_passive_exclusions": {
        "excluded_weak_value_prefixes": [
          "intend to be",
          "intends to be",
          "plan to be",
          "plans to be",
          "will be",
          "will not be"
        ],
        "passive_without_named_actor": "abstain"
      },
      "explicit_trigger_inventory": [
        "commit to",
        "commits to",
        "has committed to"
      ],
      "generic_actor_eligibility": {
        "contract": "generic_noun_phrase_actor_validation",
        "required_when_subject_type": "other"
      },
      "heading_context": {
        "confidence": 0.7,
        "cross_block_allowed": false,
        "requires_one_unique_eligible_heading": true,
        "subject_must_meet_actor_contract": true
      },
      "negation_treatment": "preserve_trigger_negation_in_raw_and_normalized_value",
      "subject_bounds": {
        "maximum_characters": 79,
        "maximum_tokens": 12,
        "minimum_tokens": 1
      },
      "warning_codes": {
        "ambiguous_heading_context": "abstained_commitment_ambiguous_heading_context",
        "clause_like_subject": "abstained_commitment_clause_like_subject",
        "copular_or_passive": "abstained_commitment_copular_or_passive",
        "ineligible_subject": "abstained_commitment_ineligible_subject",
        "subject_too_long": "abstained_commitment_subject_too_long"
      },
      "weak_trigger_inventory": [
        "intend to",
        "intends to",
        "plan to",
        "plans to",
        "will",
        "will not"
      ]
    },
